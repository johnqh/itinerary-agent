# Copy to .env and fill in. The .env file is gitignored; never commit real keys.

# Required. The model provider the agent runs on.
OPENAI_API_KEY=

# Optional. Without it, discovery stays on the offline seed dataset.
BRIGHT_DATA_API_TOKEN=

# Optional, and used by two Google APIs.
#
# Routes: without it, travel times stay straight-line estimates and transit is
# reported unavailable rather than guessed at. With it, legs carry real travel
# times, transit line names and transfer counts.
#
# Places: without it, researched attractions keep whatever photographs research
# found, and no restaurants are searched for near the days — a meal the planner
# then cannot seat is reported unseated rather than invented.
#
# Deliberately NOT VITE_-prefixed. The dev and preview servers inject this into
# proxied requests server-side, so it never reaches the browser bundle. A
# VITE_-prefixed key would be inlined into the shipped JavaScript.
#
# `bun run dev` and `bun run preview` both proxy /gmaps and /places. A static
# build served by anything else needs equivalent reverse proxies — /gmaps/* to
# https://routes.googleapis.com/* and /places/* to
# https://places.googleapis.com/*, each adding the X-Goog-Api-Key header there
# — or both providers are unavailable and the app runs in the degraded states
# above. There is no client-side alternative by design: the key must not reach
# the page.
GOOGLE_MAPS_API_KEY=

# Optional. Where `vite dev` and `vite preview` proxy /api to.
# Defaults to http://localhost:8790.
TRUEFORGE_BASE_URL=

# Optional, and only for a build served without that proxy in front of it: the
# harness URL the browser itself calls. Baked in at build time, so the harness
# must allow the page's origin. Leave blank when running through `bun run dev`
# or `bun run preview`, where the same-origin proxy already handles it.
VITE_TRUEFORGE_BASE_URL=
