# Copy to .env and fill in. The .env file is gitignored; never commit real keys.

# Required. The model provider the agent runs on.
OPENAI_API_KEY=

# Optional. Without it, discovery stays on the offline seed dataset.
BRIGHT_DATA_API_TOKEN=

# Optional. Where `vite dev` and `vite preview` proxy /api to.
# Defaults to http://localhost:8790.
TRUEFORGE_BASE_URL=

# Optional, and only for a build served without that proxy in front of it: the
# harness URL the browser itself calls. Baked in at build time, so the harness
# must allow the page's origin. Leave blank when running through `bun run dev`
# or `bun run preview`, where the same-origin proxy already handles it.
VITE_TRUEFORGE_BASE_URL=
